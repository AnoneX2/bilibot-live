# 可选：用环境变量临时覆盖少量运行参数（程序不会自动读 .env，需要 shell / systemd 注入）。
# API Key 不在这里——它只从 config.yaml 的 llm.api_key 读取（面板里填）。

# DeepSeek（或任何 OpenAI 兼容服务）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# X-ASR 模型根目录（默认 data/models/xasr；也可直接指向 X-ASR 的 deployment/models）
# XASR_MODEL_ROOT=/path/to/X-ASR-zh-en/deployment/models

# 临时覆盖运行参数
# BOT_ROOMS=123456,234567
# BOT_DRY_RUN=true
# BOT_LOG_LEVEL=INFO
